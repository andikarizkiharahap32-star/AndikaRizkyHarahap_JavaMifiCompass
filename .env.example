# ═══════════════════════════════════════
# JavaMifi Compass — Environment Config
# ═══════════════════════════════════════
# Copy to .env and adjust values

# ── App ──
NODE_ENV=development
APP_NAME=JavaMifi Compass
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# ── Database ──
DATABASE_URL=postgresql://javamifi:javamifi_dev@localhost:5432/javamifi_compass

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Auth ──
JWT_SECRET=change-me-in-production-use-64-chars-minimum-random-string-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Payment Gateway ──
# Mode: 'mock' | 'midtrans_sandbox' | 'midtrans_production'
PAYMENT_GATEWAY_MODE=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# ── eSIM Provider ──
# Mode: 'mock' | 'airalo_sandbox' | 'airalo_production'
ESIM_PROVIDER_MODE=mock
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=

# ── External APIs (keyless) ──
OPEN_METEO_BASE_URL=https://api.open-meteo.com
FRANKFURTER_BASE_URL=https://api.frankfurter.app
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1

# ── n8n ──
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=
WEBHOOK_SECRET=change-me-webhook-hmac-secret-minimum-32-chars

# ── Email (Mailpit in dev) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@javamifi.com

# ── Chat Notifications ──
# Mode: 'mock' | 'slack' | 'telegram'
NOTIFICATION_MODE=mock
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── File Upload ──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# ── Rate Limiting ──
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_TTL=900
LOGIN_THROTTLE_LIMIT=5
