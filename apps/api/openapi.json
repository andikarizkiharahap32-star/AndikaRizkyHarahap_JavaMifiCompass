    "/v1/dining/places": {
      "get": {
        "operationId": "DiningController_searchPlaces",
        "summary": "Search dining venues with Halal filtering and dual currency pricing",
        "parameters": [
          {
            "name": "country",
            "required": false,
            "in": "query",
            "description": "ISO 2-letter country code (e.g. JP, SA, SG)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "City name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "required": false,
            "in": "query",
            "description": "HALAL, NON_HALAL, or ALL",
            "schema": {
              "enum": [
                "HALAL",
                "NON_HALAL",
                "ALL"
              ],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Search term for venue or dish",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "radiusKm",
            "required": false,
            "in": "query",
            "description": "Radius in km (default 5)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "includeUnverified",
            "required": false,
            "in": "query",
            "description": "Include UNKNOWN tiers",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Sort criteria",
            "schema": {
              "enum": [
                "relevance",
                "rating",
                "distance"
              ],
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Dining (Compass Rasa Public Discovery)"
