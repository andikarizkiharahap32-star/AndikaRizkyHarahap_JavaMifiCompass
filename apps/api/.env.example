# ==============================================================================
# JavaMifi Compass — API Environment Variables (.env.example)
# Format: KEY=DEFAULT_OR_PLACEHOLDER # [Type] (Owner) Description
# ==============================================================================

# Runtime & Server
NODE_ENV=development # [enum: development|test|production] (Platform Ops) Application environment mode
PORT=3001 # [number] (Platform Ops) Local listening port for the NestJS server
APP_URL=http://localhost:3000 # [url] (Frontend Team) Base URL of consumer web application
ADMIN_URL=http://localhost:3002 # [url] (Admin Ops) Base URL of internal admin console

# Database & Caching
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/javamifi_compass # [string] (Data Eng) PostgreSQL connection string
REDIS_URL=redis://localhost:6379 # [string/optional] (Platform Ops) Redis connection URL for queues and cache

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_key_min_32_characters # [string: secret] (Security Team) Secret signing key for JWT tokens
WEBHOOK_SECRET=replace_with_webhook_hmac_secret # [string: secret] (Security Team) HMAC secret for inbound automation webhooks

# Payment Gateways & Simulation
PAYMENT_GATEWAY_MODE=mock # [enum: mock|midtrans|stripe] (Billing Team) Payment gateway driver mode
MOCK_PAYMENT_URL=http://localhost:3000/id/checkout/mock-payment # [url/optional] (Billing Team) URL for test payment simulation
STRIPE_SECRET_KEY= # [string: secret/optional] (Billing Team) Stripe secret API key (leave empty in mock)
MIDTRANS_SERVER_KEY= # [string: secret/optional] (Billing Team) Midtrans server key
MIDTRANS_CLIENT_KEY= # [string/optional] (Billing Team) Midtrans client key
MIDTRANS_IS_PRODUCTION=false # [boolean] (Billing Team) Enable Midtrans production endpoint

# External Integrations & Providers
ESIM_PROVIDER_MODE=mock # [enum: mock|live] (Telco Ops) eSIM provisioning provider driver
GEMINI_API_KEY= # [string: secret/optional] (AI Eng) Google Gemini API key for dining and vision extraction
AUTOMATION_ENABLED=true # [boolean] (Automation Ops) Master toggle for n8n workflow outbox dispatch
