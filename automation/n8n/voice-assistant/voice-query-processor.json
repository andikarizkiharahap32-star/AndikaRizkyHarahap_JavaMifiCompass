    {
      "id": "resolve_session_language",
      "name": "Resolve Session Language",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-460, 160],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Pick one language per session and hold it for the whole session.\nconst staticData = $getWorkflowStaticData('node');\nif (!staticData.languageBySession) staticData.languageBySession = {};\n\nconst sessionId = $json.sessionId;\nconst incomingLanguage = $json.language; // client's first-turn detection\n\nlet language = staticData.languageBySession[sessionId];\nif (!language) {\n  language = incomingLanguage || 'id-ID';\n  staticData.languageBySession[sessionId] = language;\n}\n\nreturn { ...$json, language };"
      }
    },
    {
      "id": "llm_intent_extraction",
      "name": "LLM Intent Extraction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 160],
      "parameters": {
        "method": "POST",
        "url": "https://integrate.api.nvidia.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_NVIDIA_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'minimaxai/minimax-m3.1-flash',\n  max_tokens: 1024,\n  temperature: 0.1,\n  messages: [\n    {\n      role: 'system',\n      content: 'You are a natural-language-understanding slot filler for a halal-restaurant voice assistant. Extract intent and slots only. You must NEVER assess, state, or imply a halal determination - that is decided downstream by a verified dataset, not by you. Respond with strict JSON only, no markdown fences: {\\\"intent\\\": \\\"find_halal_restaurant|check_account_data|other\\\", \\\"slots\\\": {\\\"location\\\": string|null, \\\"cuisine\\\": string|null, \\\"dishName\\\": string|null, \\\"certifyingBody\\\": string|null} }'\n    },\n    {\n      role: 'user',\n      content: String($json.transcript || $json.body?.transcript || 'Cari ramen halal di Tokyo')\n    }\n  ]\n}) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "parse_llm_json",
      "name": "Parse LLM JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 160],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// The LLM's only job was slot-filling. Everything from here on - which dataset is queried and which template is spoken - is deterministic backend logic, not model output.\nlet parsed;\ntry {\n  const raw = $json.choices?.[0]?.message?.content || $json.content?.[0]?.text || '{}';\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { intent: 'other', slots: {} };\n}\n\nconst allowedIntents = ['find_halal_restaurant', 'check_account_data', 'other'];\nif (!allowedIntents.includes(parsed.intent)) parsed.intent = 'other';\n\nreturn { ...$json, intent: parsed.intent, slots: parsed.slots || {} };"
      }
    },
    {
      "id": "switch___route_by_intent",
      "name": "Switch - Route By Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [260, 160],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{$json.intent}}",
                    "rightValue": "find_halal_restaurant",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "find_halal_restaurant"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{$json.intent}}",
                    "rightValue": "check_account_data",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "check_account_data"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "search_certified_dataset",
      "name": "Search Certified Dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, -120],
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3001/api/restaurants/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "location",
              "value": "={{$json.slots.location || ''}}"
            },
            {
              "name": "cuisine",
              "value": "={{$json.slots.cuisine || ''}}"
            },
            {
              "name": "dish",
              "value": "={{$json.slots.dishName || ''}}"
            }
          ]
        },
        "options": {
