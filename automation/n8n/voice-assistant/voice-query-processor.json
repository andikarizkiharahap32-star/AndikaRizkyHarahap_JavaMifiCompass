{
  "name": "Voice Assistant - 2. Process Confirmed Query",
  "nodes": [
    {
      "id": "sticky___core_rule",
      "name": "Sticky - Core Rule",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1180, -520],
      "parameters": {
        "content": "## Core rule (do not break this)\nThe LLM node below does ONE job: turn speech-derived text into structured intent + slots. It never decides what's true about halal status and never free-texts a confidence level. Every response template in this workflow is picked deterministically by the branch that executed (certified / OSM / unavailable / none), not by a second model call.",
        "height": 240,
        "width": 420
      }
    },
    {
      "id": "sticky___rate_limit",
      "name": "Sticky - Rate Limit",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1180, -40],
      "parameters": {
        "content": "Per-session rate limit, protecting the shared Google Places/Overpass call budget. Demo uses workflow static data - swap for Redis/Postgres so the counter is shared across workers in production.",
        "height": 160,
        "width": 300
      }
    },
    {
      "id": "sticky___language_lock",
      "name": "Sticky - Language Lock",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-820, -40],
      "parameters": {
        "content": "Pick one language per session and hold it - ask/detect once, reuse for every template and the TTS voice for the rest of the session, including number/currency formatting.",
        "height": 160,
        "width": 300
      }
    },
    {
      "id": "sticky___circuit_breaker",
      "name": "Sticky - Circuit Breaker",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [260, 260],
      "parameters": {
        "content": "Circuit breaker on the Overpass call: short timeout + onError=continueErrorOutput. On failure/timeout this branch says so plainly and stops - it never silently falls back to a guess or a stale cache.",
        "height": 180,
        "width": 320
      }
    },
    {
      "id": "sticky___age_gate_+_hedge",
      "name": "Sticky - Age Gate + Hedge",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [580, 0],
      "parameters": {
        "content": "OSM path only: tags past the staleness threshold are dropped; surviving tags get a mandatory, per-utterance hedge sentence with the last-edit date, never a yes/no halal verdict. Every OSM-sourced recommendation actually spoken is logged (place id, tag snapshot, timestamp).",
        "height": 200,
        "width": 340
      }
    },
    {
      "id": "sticky___two_trust_levels",
      "name": "Sticky - Two Trust Levels",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [260, 760],
      "parameters": {
        "content": "Restaurant recommendation = public data, no login required. Account/data-balance lookup = identified caller required. These are two separate branches with two separate auth requirements, not one 'ask anything' intent.",
        "height": 180,
        "width": 320
      }
    },
    {
      "id": "receive_confirmed_query",
      "name": "Receive Confirmed Query",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1180, 160],
      "parameters": {
        "httpMethod": "POST",
        "path": "voice/query",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "voice-query"
    },
    {
      "id": "rate_limit_check",
      "name": "Rate Limit Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-940, 160],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Simple per-session rate limiter using workflow static data.\n// Replace with Redis/Postgres for a multi-worker deployment.\nconst WINDOW_MS = 10 * 60 * 1000; // 10 minutes\nconst MAX_REQUESTS = 20;\n\nconst sessionId = $json.sessionId || $json.body?.sessionId || 'anonymous-session';\nconst transcript = $json.transcript || $json.body?.transcript || '';\nconst language = $json.language || $json.body?.language || 'id';\n\nconst staticData = $getWorkflowStaticData('node');\nif (!staticData.sessions) staticData.sessions = {};\n\nconst now = Date.now();\nconst record = staticData.sessions[sessionId] || { count: 0, windowStart: now };\n\nif (now - record.windowStart > WINDOW_MS) {\n  record.count = 0;\n  record.windowStart = now;\n}\nrecord.count += 1;\nstaticData.sessions[sessionId] = record;\n\nconst rateLimited = Boolean(sessionId) && record.count > MAX_REQUESTS;\nreturn { ...$json, sessionId, transcript, language, rateLimited, requestsInWindow: record.count };"
      }
    },
    {
      "id": "if___rate_limited",
      "name": "IF - Rate Limited",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-700, 160],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.rateLimited}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "build_rate_limit_response",
      "name": "Build Rate Limit Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-700, 320],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const responseText = 'Terlalu banyak permintaan dalam waktu singkat. Silakan coba lagi dalam beberapa menit.';\nreturn { ...$json, responseText, sourceTier: 'rate_limited' };"
      }
    },
    {
      "id": "respond___rate_limited",
      "name": "Respond - Rate Limited",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-460, 320],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 429
        }
