        }
      }
    },
    {
      "id": "build_certified_response",
      "name": "Build Certified Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, -220],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Certified-tier template - fixed wording, backend-decided.\nconst place = $json.results[0];\nconst responseText =\n  `${place.name}, tersertifikasi oleh ${place.certifyingBody}, ` +\n  `berlaku sampai ${place.expiryDate}.`;\nreturn { ...$json, responseText, sourceTier: 'certified', place };"
      }
    },
    {
      "id": "query_overpass_osm",
      "name": "Query Overpass OSM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 0],
      "parameters": {
        "method": "GET",
        "url": "https://overpass-api.de/api/interpreter",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "data",
              "value": "=[out:json][timeout:4];node[\"diet:halal\"](around:2000,{{$json.slots.latitude || -6.2}},{{$json.slots.longitude || 106.8}});out body;"
            }
          ]
        },
        "options": {
          "timeout": 4000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "onError": "continueErrorOutput"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "build_service_unavailable_response",
      "name": "Build Service Unavailable Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, -40],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Circuit breaker tripped: say so plainly, never fall back to a guess or a stale cache without disclosing it.\nconst responseText =\n  'Tidak dapat terhubung ke basis data terverifikasi saat ini. ' +\n  'Silakan coba lagi sebentar lagi.';\nreturn { ...$json, responseText, sourceTier: 'unavailable' };"
      }
    },
    {
      "id": "age_gate_osm_tags",
      "name": "Age-Gate OSM Tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 60],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Exclude stale community tags; keep the last-edit age for the ones that survive so it can be spoken in the hedge sentence.\nconst STALE_DAYS = 180;\nconst now = Date.now();\n\nconst elements = $json.elements || [];\nconst valid = elements\n  .filter(el => el.tags && el.tags['diet:halal'])\n  .map(el => {\n    const lastEdited = el.timestamp ? new Date(el.timestamp).getTime() : 0;\n    const ageDays = lastEdited ? Math.floor((now - lastEdited) / 86400000) : Infinity;\n    return { ...el, ageDays };\n  })\n  .filter(el => el.ageDays <= STALE_DAYS);\n\nreturn { ...$json, validOsmResults: valid };"
      }
    },
    {
      "id": "if___any_valid_osm_result",
      "name": "IF - Any Valid OSM Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 60],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.validOsmResults?.length || 0}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "build_no_result_response",
      "name": "Build No Result Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, -40],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const responseText = 'Maaf, belum ada tempat terverifikasi yang cocok dengan pencarian Anda.';\nreturn { ...$json, responseText, sourceTier: 'none' };"
      }
    },
    {
      "id": "build_osm_hedge_response",
      "name": "Build OSM Hedge Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 100],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Mandatory spoken evidence line, EVERY time this result is spoken - never a yes/no halal verdict from a community tag.\nconst place = $json.validOsmResults[0];\nconst name = (place.tags && place.tags.name) || 'Tempat ini';\nconst ageDays = Number.isFinite(place.ageDays) ? place.ageDays : 'beberapa';\nconst responseText =\n  `${name}, dari data komunitas OpenStreetMap (terakhir diperbarui ` +\n  `${ageDays} hari lalu), belum kami verifikasi - konfirmasi ke staf ` +\n  `sebelum memesan.`;\nreturn { ...$json, responseText, sourceTier: 'osm', place };"
      }
    },
    {
      "id": "log_osm_recommendation",
      "name": "Log OSM Recommendation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2080, 100],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/audit/osm-recommendation",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  placeId: $json.place.id,\n  tagSnapshot: $json.place.tags,\n  sessionId: $json.sessionId,\n  timestamp: new Date().toISOString()\n}) }}",
        "options": {
          "timeout": 4000
        }
      }
    },
    {
      "id": "if___is_authenticated",
      "name": "IF - Is Authenticated",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 520],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.authToken}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "or"
        }
      }
    },
    {
      "id": "build_auth_required_response",
      "name": "Build Auth Required Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 620],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Identified caller required before any account data is fetched.\nconst responseText =\n  'Untuk melihat sisa data Anda, mohon konfirmasi nomor pesanan atau ' +\n  'masuk ke akun Anda terlebih dahulu.';\nreturn { ...$json, responseText, sourceTier: 'auth_required' };"
      }
    },
    {
      "id": "fetch_account_data",
      "name": "Fetch Account Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 440],
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3001/api/account/data-balance",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.authToken}}"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      }
    },
    {
      "id": "build_account_response",
      "name": "Build Account Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 440],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const responseText =\n  `Sisa kuota data Anda adalah ${$json.account.remainingDataGb} GB, ` +\n  `berlaku sampai ${$json.account.expiryDate}.`;\nreturn { ...$json, responseText, sourceTier: 'account' };"
      }
    },
    {
      "id": "build_fallback_response",
      "name": "Build Fallback Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 820],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const responseText =\n  'Maaf, saya belum memahami permintaan Anda. Anda bisa bertanya ' +\n  'tentang rekomendasi restoran halal atau sisa kuota data.';\nreturn { ...$json, responseText, sourceTier: 'fallback' };"
      }
    },
    {
      "id": "text_to_speech",
      "name": "Text-to-Speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2340, 260],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/speech",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer dummy-tts-key"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'tts-1',\n  voice: $json.language && $json.language.startsWith('en') ? 'alloy' : 'nova',\n  input: $json.responseText\n}) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "build_final_payload",
      "name": "Build Final Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2600, 260],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Build final multimodal payload robustly\nconst candidateNodes = [\n  'Build Certified Response',\n  'Build OSM Hedge Response',\n  'Build No Result Response',\n  'Build Service Unavailable Response',\n  'Build Account Response',\n  'Build Auth Required Response',\n  'Build Fallback Response'\n];\n\nlet responseText = '';\nlet sourceTier = 'certified';\nlet language = 'id';\nlet transcript = '';\n\nfor (const name of candidateNodes) {\n  try {\n    const items = $(name).all();\n    if (items && items.length > 0 && items[0].json && items[0].json.responseText) {\n      responseText = items[0].json.responseText;\n      sourceTier = items[0].json.sourceTier || sourceTier;\n      language = items[0].json.language || language;\n      break;\n    }\n  } catch (e) {}\n}\n\ntry { transcript = $('Rate Limit Check').first().json.transcript; } catch (e) {}\ntry { language = $('Resolve Session Language').first().json.language; } catch (e) {}\n\nreturn [{\n  json: {\n    transcriptEcho: transcript,\n    responseText: responseText || 'Layanan suara JavaMifi siap membantu.',\n    sourceTier: sourceTier,\n    language: language\n  }\n}];"
      }
    },
    {
      "id": "respond___send_voice_response",
      "name": "Respond - Send Voice Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2860, 260],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Receive Confirmed Query": {
      "main": [
        [
          {
            "node": "Rate Limit Check",
            "type": "main",
            "index": 0
          }
        ]
