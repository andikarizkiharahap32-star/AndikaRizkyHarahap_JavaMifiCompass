        }
      }
    },
    {
      "id": "if___certified_match_found",
      "name": "IF - Certified Match Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, -120],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.results?.length || 0}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
